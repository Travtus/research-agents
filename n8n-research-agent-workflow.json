{
  "name": "AI Legislation Research Agent",
  "nodes": [
    {
      "parameters": {
        "path": "ai-legislation",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: Trigger Research",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://your-vercel-url.vercel.app/api/research/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input_as_text: $json.body.query || 'Generate the latest AI legislation brief for the past month' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "call-research-agent",
      "name": "Call Research Agent API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parsed-output",
              "name": "legislationReport",
              "value": "={{ $json.data.output_parsed }}",
              "type": "object"
            },
            {
              "id": "text-output",
              "name": "reportText",
              "value": "={{ $json.data.output_text }}",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "generatedAt",
              "value": "={{ $json.metadata.timestamp }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, report: $json.legislationReport, generatedAt: $json.generatedAt } }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [910, 300]
    }
  ],
  "connections": {
    "Webhook: Trigger Research": {
      "main": [
        [
          {
            "node": "Call Research Agent API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Research Agent API": {
      "main": [
        [
          {
            "node": "Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Output": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [
    {
      "name": "AI",
      "id": "ai-tag"
    },
    {
      "name": "Research",
      "id": "research-tag"
    }
  ],
  "triggerCount": 0,
  "updatedAt": "2025-10-24T00:00:00.000Z",
  "versionId": "1"
}

